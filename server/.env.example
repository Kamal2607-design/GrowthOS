# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://postgres:my_password@localhost:5432/growth_os"
PORT=5000
JWT_SECRET=1cb1c6a8e09d56efebee26013a0b3f6c55fe42d13dac182dd25c4edcf7b1f0a94abef16833386c2177de7b88fcbfd2823c5d84b62ac24d95cf0e3f9e6e97d91d
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Browser origin(s) allowed to call the API with cookies (comma-separated).
CLIENT_ORIGIN=http://localhost:5173

# Where Google sign-in sends the browser afterwards (the web app).
# Leave unset to get the JSON response instead.
CLIENT_APP_URL=http://localhost:5173

# Optional auth cookie overrides (defaults: growthos_token, false, lax).
# JWT_COOKIE_NAME=growthos_token
# JWT_COOKIE_SECURE=false
# JWT_COOKIE_SAME_SITE=lax

# Where uploaded documents are stored (default: server/storage/documents)
# and the maximum upload size in megabytes (default: 20).
# DOCUMENT_STORAGE_DIR=/absolute/path/to/storage
# DOCUMENT_MAX_UPLOAD_MB=20
