// use prisma-8

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  username     String?  @unique
  name         String?
  passwordHash String?

  oauthAccounts OAuthAccount[]

  vision       Vision?
  goals        Goal[]
  actions      Action[]
  actionSuggestions ActionSuggestion[]
  reflections  Reflection[]
  documents    Document[]
  memories     Memory[]
  timeline     TimelineEvent[]
  reflectionAnalyses ReflectionAnalysis[]
  documentCandidates DocumentCandidate[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())
}

model Vision {
  id          Int             @id @default(autoincrement())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int             @unique

  statement   String
  values      String?
  identity    String?
  futureSelf  String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
}

model Goal {
  id          Int      @id @default(autoincrement())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int

  sourceCandidate DocumentCandidate? @relation(
    "GoalSourceCandidate",
    fields: [sourceCandidateId],
    references: [id],
    onDelete: SetNull
  )
  sourceCandidateId Int? @unique

  title       String
  description String?
  status      String   @default("active")
  priority    Int      @default(0)
  targetDate  DateTime?

  actions     Action[]
  suggestions ActionSuggestion[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([userId])
  @@index([status])
}

model Action {
  id          Int      @id @default(autoincrement())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int

  goal        Goal?    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  goalId      Int?

  suggestion  ActionSuggestion? @relation(fields: [suggestionId], references: [id], onDelete: SetNull)
  suggestionId Int? @unique

  sourceCandidate DocumentCandidate? @relation(
    "ActionSourceCandidate",
    fields: [sourceCandidateId],
    references: [id],
    onDelete: SetNull
  )
  sourceCandidateId Int? @unique

  title       String
  description String?
  status      String   @default("pending")
  priority    Int      @default(0)

  dueDate     DateTime?
  completedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([userId])
  @@index([goalId])
  @@index([status])
}

model Reflection {
  id          Int             @id @default(autoincrement())

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int

  content     String
  mood        String?
  productivity Int?
  highlights  String?
  challenges  String?
  learnings   String?

  reflectionDate DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())

  analysis       ReflectionAnalysis?
  actionSuggestions ActionSuggestion[]

  @@index([userId])
  @@index([reflectionDate])
}

model Document {
  id             Int             @id @default(autoincrement())
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         Int

  fileName       String
  filePath       String
  mimeType       String
  fileSize       Int
  processingStatus String        @default("pending")
  extractionMethod String?

  extractedText  String?
  summary        String?
  structuredData String?
  candidates DocumentCandidate[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())

  @@index([userId])
  @@index([processingStatus])
}

model Memory {
  id Int @id @default(autoincrement())

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )
  userId Int

  sourceCandidate DocumentCandidate? @relation(
    "MemorySourceCandidate",
    fields: [sourceCandidateId],
    references: [id],
    onDelete: SetNull
  )
  sourceCandidateId Int? @unique

  type String
  content String
  normalizedContent String?

  source String?
  importance Int @default(1)

  status String @default("active")
  normalizationStatus String @default("pending")
  normalizedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([userId, status])
  @@index([userId, normalizationStatus])
}

model TimelineEvent {
  id          Int             @id @default(autoincrement())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int

  eventType   String
  title       String
  description String?
  eventDate   DateTime @default(now())

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([eventDate])
  @@index([eventType])
}

model OAuthAccount {
  id                Int      @id @default(autoincrement())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            Int

  provider          String
  providerAccountId String

  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model ActionSuggestion {
  id          Int      @id @default(autoincrement())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int

  goal        Goal?    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  goalId      Int?

  title       String
  description String?

  priority    Int      @default(0)
  reasoning   String?

  status      String   @default("pending")
  source      String   @default("ai")

  action      Action?
  reflection      Reflection? @relation(fields: [reflectionId], references: [id], onDelete: SetNull)
  reflectionId    Int?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([userId])
  @@index([goalId])
  @@index([status])
}

model ReflectionAnalysis {
  id          Int        @id @default(autoincrement())

  reflection  Reflection @relation(fields: [reflectionId], references: [id], onDelete: Cascade)
  reflectionId Int        @unique

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int

  summary              String?
  moodAnalysis         String?
  productivityAnalysis String?

  highlights            String?
  challenges            String?
  learnings             String?
  goalAlignment         String?
  progressAnalysis      String?
  recommendedActions    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([userId])
}

model DocumentCandidate {
  id Int @id @default(autoincrement())

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )
  userId Int

  document Document @relation(
    fields: [documentId],
    references: [id],
    onDelete: Cascade
  )
  documentId Int

  type String
  sourceIndex Int

  title String?
  content String?
  reason String?
  importance Int?

  status String @default("pending")
  reviewedAt DateTime?

  memory Memory? @relation("MemorySourceCandidate")
  goal Goal? @relation("GoalSourceCandidate")
  action Action? @relation("ActionSourceCandidate")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@unique([documentId, type, sourceIndex])
  @@index([userId, status])
  @@index([documentId])
  @@index([type])
}